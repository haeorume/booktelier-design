{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test -c playwright.server.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && node ../scripts/check-invariants.mjs",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/types/api.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "cd..": "^0.0.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
