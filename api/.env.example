# api/.env 로 복사해서 값을 채워요. api/.env 는 저장소에 올리지 않아요(.gitignore).
# 이름과 뜻: docs/DEPLOY.md '환경 변수'

APP_ENV=local
# Neon 콘솔 → 내 브랜치(dev-이름) → Connect 의 주소. postgresql:// 로 시작해도 돼요(psycopg 3 주소로 바꿔 씀)
DATABASE_URL=
# 자동 테스트용. 반드시 DATABASE_URL과 다른 Neon 브랜치(test-이름)
TEST_DATABASE_URL=
# 웹 주소만, 쉼표로 여러 개
CORS_ORIGINS=http://localhost:3000
# demo | llm. llm은 F6부터
AI_PROVIDER=demo
