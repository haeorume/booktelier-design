{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm --prefix web run *)",
      "Bash(npx playwright test *)",
      "Bash(node scripts/check-invariants.mjs)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./web/.env)",
      "Read(./web/.env.*)",
      "Edit(./.claude/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./scripts/check-invariants.mjs)",
      "Edit(./docs/DECISIONS.md)",
      "Edit(./docs/sheets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/after-edit.mjs"],
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.mjs"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
